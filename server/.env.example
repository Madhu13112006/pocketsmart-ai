# Copy to .env and fill in. Never commit the real .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pocketsmart

# Required in production: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sessions last this many days.
JWT_DAYS=7

# Only needed if the React app is hosted on a different origin from this API
# (comma-separated). When one server serves both, leave these unset.
CLIENT_ORIGIN=
# COOKIE_SAMESITE=none      # cross-site hosting only; requires HTTPS
# COOKIE_SECURE=false       # production build over plain HTTP only (local docker)
